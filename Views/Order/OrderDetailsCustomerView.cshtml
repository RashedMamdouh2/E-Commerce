@model OrderViewModel
@{
    ViewData["Title"] = "Order Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .product-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            transition: transform 0.2s ease;
        }

            .product-img:hover {
                transform: scale(1.1);
            }

        .product-name {
            font-weight: 600;
            display: block;
            margin-top: 5px;
            text-decoration: none;
        }

            .product-name:hover {
                text-decoration: underline;
                color: #0d6efd;
            }

        .table tfoot th {
            vertical-align: middle;
        }
    </style>
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-receipt"></i> Order Details #@Model.Id</h4>
                <a asp-action="ShowCustomerOrders" asp-controller="Order" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Back to Orders
                </a>
            </div>

            <div class="card-body">
                <!-- Customer Info -->
                <h5 class="text-secondary mb-3"><i class="bi bi-person"></i> Customer Information</h5>
                <ul class="list-group mb-4">
                    <li class="list-group-item"><strong>Name:</strong> @Model.CustomerName</li>
                    <li class="list-group-item"><strong>Email:</strong> @Model.CustomerEmail</li>
                    <li class="list-group-item"><strong>Phone:</strong> @Model.CustomerPhoneNumber</li>
                    <li class="list-group-item"><strong>Order Date:</strong> @Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</li>
                    <li class="list-group-item">
                        <strong>Status:</strong>
                        <span class="badge bg-@(Model.Status == OrderStatus.Delivered.ToString() ? "success" : Model.Status == OrderStatus.Pending.ToString() ? "warning" : "secondary")">
                            @Model.Status
                        </span>
                    </li>
                </ul>

                <!-- Products -->
                <h5 class="text-secondary mb-3"><i class="bi bi-box-seam"></i> Products</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle text-center">
                        <thead class="table-primary">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-start">
                                        <div class="d-flex align-items-center">
                                            <img src="@item.MainImagePath" alt="@item.Name" class="product-img me-3 border">
                                            <div>
                                                <a asp-action="ShowProduct" asp-controller="Product" asp-route-id="@item.Id" class="product-name">
                                                    @item.Name
                                                </a>
                                                <small class="text-muted">#@item.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.Price.ToString("C")</td>
                                    <td>@item.Amount</td>
                                    <td>@((item.Price * item.Amount).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary">
                                <th colspan="4" class="text-end">Total Before Discounts:</th>
                                <th>@Model.InvoiceBeforeCoupons.ToString("C")</th>
                            </tr>

                            @if (Model.AppliedCoupons.Any())
                            {
                                @foreach (var coupon in Model.AppliedCoupons)
                                {
                                    <tr class="table-warning">
                                        <th colspan="4" class="text-end">Discount Coupon (@coupon.Name):</th>
                                        <th>-@coupon.Value%</th>
                                    </tr>
                                }

                                <tr class="table-success">
                                    <th colspan="4" class="text-end">Total After Discounts:</th>
                                    <th>@Model.InvoiceAfterCoupons.ToString("C")</th>
                                </tr>
                            }
                        </tfoot>
                    </table>

                    @if (!Model.AppliedCoupons.Any())
                    {
                        <div class="alert alert-warning mt-4" role="alert">
                            <i class="bi bi-info-circle"></i> No coupons were applied to this order.
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                <div class="text-end mt-4">
                    <a href="/Admin/Orders/Edit/@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil-square"></i> Edit Order
                    </a>
                    <a href="/Admin/Orders/Delete/@Model.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete Order Details
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
