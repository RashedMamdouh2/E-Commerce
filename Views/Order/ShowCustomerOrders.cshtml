
@model IEnumerable<E_Commerce.Models.Order>
@{
    ViewData["Title"] = "ShowCustomerOrders";
}





<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- DataTables Bootstrap 5 -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<section id="hero" class="hero section accent-background">

<div class="container gy-4">
  

    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body p-0">
                
            <table id="ordersTable" class="table table-hover table-striped align-middle mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Total Invoice</th>
                        <th>Order Date</th>
                        <th>Order Status</th>
                        
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.InvoiceValue.ToString("C")</td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge bg-@(item.Status == OrderStatus.Delivered ? "success" : item.Status == OrderStatus.Shipped ? "warning text-dark" : "secondary")">
                                    @item.Status.ToString()
                                </span>
                            </td>
                            
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <a asp-action="ChangeStatus" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-arrow-repeat"></i> Cancel
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</section>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<!-- jQuery & DataTables -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#ordersTable').DataTable({
            "pageLength": 10,
            "lengthChange": false,
            "ordering": true,
            "language": {
                "search": "Search orders:",
                "paginate": {
                    "previous": "&laquo;",
                    "next": "&raquo;"
                },
                "info": "Showing _START_ to _END_ of _TOTAL_ orders"
            }
        });
    });
</script>

