@model IEnumerable<E_Commerce.Models.Order>

@{
    ViewData["Title"] = "Orders List";
}

<section id="hero" class="hero section accent-background">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #fff;">Orders List</h2>
            <p class="text-muted" style="color: #001;">Manage and review all customer orders below.</p>
        </div>

        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-0">
                <table id="ordersTable" class="table table-hover align-middle mb-0">
                    <thead style="background-color: #5846f9; color: #fff;" class="text-center">
                        <tr>
                            <th>Total Invoice</th>
                            <th>Order Date</th>
                            <th>Status</th>
                            <th>Customer</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-success">@item.TotalPriceBeforeDiscount.ToString("C")</td>
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge bg-@(item.Status == OrderStatus.Delivered ? "success" : item.Status == OrderStatus.Pending ? "warning text-dark" : "secondary")">
                                        @item.Status.ToString()
                                    </span>
                                </td>
                                <td>@item.Customer.UserName</td>
                                <td>
                                    <a asp-action="Details" asp-controller="Order" asp-route-id="@item.Id" asp-route-view="Admin"
                                       class="btn btn-sm btn-outline-primary me-2">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    <a asp-action="ChangeStatus" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-arrow-repeat"></i> Change Status
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- DataTables -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#ordersTable').DataTable({
            "pageLength": 8,
            "lengthChange": false,
            "ordering": true,
            "language": {
                "search": "Search Orders:",
                "paginate": {
                    "previous": "&laquo;",
                    "next": "&raquo;"
                },
                "info": "Showing _START_ to _END_ of _TOTAL_ orders"
            }
        });
    });
</script>

<style>
    #ordersTable tbody tr:hover {
        background-color: #f9f7ff !important;
        transition: background-color 0.2s ease-in-out;
    }

    .dataTables_filter input {
        border-radius: 8px;
        border: 1px solid #ccc;
        padding: 5px 10px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px !important;
        margin: 0 2px !important;
        border: none !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background-color: #5846f9 !important;
        color: white !important;
    }

    .dataTables_info {
        color: #555;
        margin-top: 10px;
    }

    .card {
        overflow: hidden;
    }
</style>
